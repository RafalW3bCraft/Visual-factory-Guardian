# Public browser-visible API origin. Never put secrets here. Empty = unconfigured.
VITE_API_BASE_URL=

# Bearer token the dashboard sends to the backend. MUST match the value of
# VFG_API_BEARER_TOKEN set on the backend. When the backend has no token
# configured, leave this empty and the dashboard will send no Authorization
# header. When the backend requires a token, the dashboard will refuse to
# call the Live Analysis workspace until both env vars are set.
# This file is build-time only — it is bundled into the static site, so do
# NOT use a high-value secret here. Use a token unique to the deployment.
VITE_API_BEARER_TOKEN=